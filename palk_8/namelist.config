! ============================================================================
! ============ Namelist file for FESOM2 general configuration ================
! ============================================================================
! palk_7 on FESOM2.8.0 + XIOS. Structure follows the 2.8.0 template (see
! jack_6/namelist.config for the sibling merge of jack_4's values onto this
! same structure); VALUES below come from the old (pre-2.8.0) palk_7 config
! at /home/a/a270067/fesom2/palk_7/namelist.config, not from jack.
! ============================================================================

! ============================================================================
! RUN IDENTIFICATION
! ============================================================================
&modelname
runid = 'fesom'        ! run identifier (used in output filenames)
/

! ============================================================================
! TIME STEPPING AND RUN LENGTH
! ============================================================================
&timestep
step_per_day      = 192        ! 450s timestep (86400/192=450), matches old palk_7's NODT=450
run_length        = 1          ! total length of simulation run (2026-09-17: reduced from 2 to 1 year for this run)
run_length_unit   = 'y'        ! unit for run_length: 'y' (years), 'm' (months), 'd' (days), 's' (steps)
/

! ============================================================================
! INITIAL TIME/DATE SETTINGS
! ============================================================================
! Only used as a cold-start fallback: a valid restart (fesom.clock + raw
! restart dumps) is staged at ResultPath below (from P36's end-of-1950
! state), so FESOM will resume from there instead of using this block.
! yearnew is the COLD-START year only, and must stay less than the actual
! restart year so it never gets mistaken for the real resume point -- kept
! at 1948 and never touched, per standing project convention.
&clockinit
timenew = 0.0                  ! initial time within the day [seconds] (0.0 = midnight)
daynew  = 1                    ! initial day of the month (1-31)
yearnew = 1948                 ! initial year (cold-start only; must stay < actual restart year, never edit)
/

! ============================================================================
! MESH, INITIALIZATION & OUTPUT PATHS
! ============================================================================
&paths
MeshPath         = '/work/ab0995/a270067/fesom2/palk/mesh/'           ! palk mesh
ClimateDataPath  = '/home/a/a270067/fesom2-2.8.0/palk_8/hydrography_patched/' ! NOT cold-start-only: gen_ic3d.F90 always reads T/S climatology here as a reference field, restart or not. Points at a local dir (symlinks to the real /work/ba1254/.../hydrography/ files) with a patched phc3.0_winter.nc that has _FillValue/missing_value added -- the original lacks them, which crashed 2.8.0's stricter NetCDF reader (check_nferr calls stop on any missing attribute) even though the same file worked fine with the old pre-2.8.0 binary.
ForcingDataPath  = ''                                                 ! unused: all file names in namelist.forcing are absolute (palk setup, same as jack)
ResultPath       = '/scratch/a/a270067/palk_8/'                       ! path for output files, fesom.clock, and staged restart
RestartInPath    = ''                                                 ! where restarts are read from; empty means ResultPath
RestartOutPath   = ''                                                 ! where restarts are written to; empty means ResultPath
/

! ============================================================================
! RESTART AND LOGGING CONFIGURATION
! ============================================================================
&restart_log
restart_length          = 1        ! frequency for netCDF restart files (required for d,h,s; y,m use 1)
restart_length_unit     = 'y'      ! unit: 'y' (years), 'm' (months), 'd' (days), 'h' (hours), 's' (steps), 'off' (disabled)
raw_restart_length      = 1        ! frequency for raw core dump restart files
raw_restart_length_unit = 'm'      ! unit: 'y', 'm', 'd', 'h', 's', 'off'
bin_restart_length      = 1        ! frequency for binary derived type restart files
bin_restart_length_unit = 'off'    ! unit: 'y', 'm', 'd', 'h', 's', 'off'
logfile_outfreq         = 24       ! log file output frequency [number of time steps] (old palk_7: 10800s/450s = 24)
/

! ============================================================================
! VERTICAL COORDINATE SYSTEM (ALE - Arbitrary Lagrangian-Eulerian)
! ============================================================================
&ale_def
which_ALE          = 'linfs'     ! vertical coordinate type: 'linfs','zlevel','zstar' (old palk_7: linfs)
use_partial_cell   = .false.
/

! ============================================================================
! GRID GEOMETRY AND ROTATION
! ============================================================================
&geometry
cartesian       = .false.
fplane          = .false.
cyclic_length   = 360            ! [degree]
rotated_grid    = .true.
force_rotation  = .true.
alphaEuler      = 50.            ! [degree] Euler angles, convention:
betaEuler       = 15.            ! first around z, then around new x,
gammaEuler      = -90.           ! then around new z. (identical to jack_6's rotation, both share this convention)
/

! ============================================================================
! CALENDAR SETTINGS
! ============================================================================
! NOTE: deliberately .false. here, UNLIKE jack_6 (.true.) - this is palk's
! own setting, confirmed consistent with the staged restart's fesom.clock
! (365-day non-leap arithmetic: e.g. "86040 365 1950" / "0.0 1 1951").
&calendar
include_fleapyear = .false.
/

! ============================================================================
! MODEL COMPONENTS AND FEATURES
! ============================================================================
&run_config
use_ice                  = .true.        ! ocean+ice (old palk_7 value)
use_cavity               = .false.       ! old palk_7 value
use_cavity_partial_cell  = .false.       ! old palk_7 value
use_floatice              = .false.       ! old palk_7 value
use_sw_pene              = .true.        ! old palk_7 value (NOTE: differs from jack_6's .false. - kept palk's own value)
flag_debug               = .false.       ! 2.8.0-only field, no old-palk precedent -> stock default
use_transit               = .false.       ! 2.8.0-only field, no old-palk precedent -> stock default
use_hosing               = .false.       ! 2.8.0-only field, no old-palk precedent -> stock default
hosing_mode               = 'surf'        ! 2.8.0-only field, no old-palk precedent -> stock default
hosing_hSv               = 0.0           ! 2.8.0-only field, no old-palk precedent -> stock default
/

! ============================================================================
! PARALLEL DECOMPOSITION (DOMAIN PARTITIONING)
! ============================================================================
&machine
n_levels = 1             ! old palk_7 value
n_part   = 3456           ! old palk_7 value - matches the staged restart's np3456 partitioning and palk7.job's --ntasks=3456
/

! ============================================================================
! ICEBERG SETTINGS
! ============================================================================
! No iceberg block existed in the old palk_7 config at all - no palk-specific
! value to preserve. Using 2.8.0 stock defaults (icebergs disabled), same as
! jack_6.
&icebergs
use_icesheet_coupling = .false.
ib_num                = 1
use_icebergs          = .false.
steps_per_ib_step     = 8
ib_async_mode         = 0
l_allowgrounding      = 2
/

! ============================================================================
! PARALLEL I/O
! ============================================================================
! No precedent in the old palk_7 config either - using 2.8.0 stock defaults,
! same as jack_6.
&io_parallel
parallel_write    = .false.
n_writers         = 0
n_writers_restart = -1
n_readers_restart = -1
chunk_levels      = 8
/
